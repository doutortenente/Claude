{
  "worktree": { "bgIsolation": "none" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-files.sh"
          }
        ]
      }
    ]
  }
}
