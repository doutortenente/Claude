{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/dr/.codex/hooks/prefer-ide-tools.sh'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/dr/.codex/hooks/prefer-ide-tools.sh'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node /home/dr/.tokentracker/bin/notify.cjs --source=claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node /home/dr/.tokentracker/bin/notify.cjs --source=claude"
          }
        ]
      }
    ]
  }
}
